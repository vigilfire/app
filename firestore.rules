rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // The internal Vigil Fire operator account — a custom claim set only by
    // the `grantSuperadmin` Cloud Function (email-allowlisted there), never by
    // any client write. Used solely by the separate /admin section; ordinary
    // app users never have this claim.
    function isSuperadmin() {
      return isSignedIn() && request.auth.token.role == 'superadmin';
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/technicians/$(request.auth.uid)).data.role == 'admin';
    }
    // The signed-in user's own tenant. Every multi-tenant collection carries a
    // `companyId` field so this is one lookup, not a join per document.
    function myCompanyId() {
      return get(/databases/$(database)/documents/technicians/$(request.auth.uid)).data.companyId;
    }
    // An admin may manage a document only within their own company — plain
    // `isAdmin()` alone would let any company's admin reach any other
    // company's data, since role is otherwise unscoped.
    function isCompanyAdmin(companyId) {
      return isAdmin() && myCompanyId() == companyId;
    }
    function isAssignedToSite(siteId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/sites/$(siteId)).data.assignedTo;
    }
    // A Competent Person's site assignment for the SANS 10105-1 monthly
    // check — a separate list from assignedTo (maintenance technicians) on
    // purpose, so the two kinds of access never overlap.
    function isAssignedAsCompetentPerson(siteId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/sites/$(siteId)).data.assignedCompetentPersons;
    }
    function canCalibrate() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/technicians/$(request.auth.uid)).data.canCalibrate == true;
    }
    // Whether this company has been granted the Audit add-on (Company
    // Documents / Employees / Vehicles / Workshops / Calibration) by a
    // superadmin in admin.html. A missing companyAddons doc means "no
    // add-on" — exists() is checked explicitly rather than relying on a
    // failed get() to deny, so that intent reads clearly here.
    function hasAuditAddon(companyId) {
      return isSuperadmin() || (
        exists(/databases/$(database)/documents/companyAddons/$(companyId)) &&
        get(/databases/$(database)/documents/companyAddons/$(companyId)).data.audit == true
      );
    }

    // Internal operator dashboard (separate admin.html, superadmin-only).
    // Nothing here is reachable by an ordinary company admin/technician/trainee.
    match /companies/{companyId} {
      allow read, write: if isSuperadmin();
    }

    // Per-company add-on flags, set only by a superadmin from admin.html (the
    // company's own admin may read theirs, to know whether to show the Audit
    // tab). Kept separate from `companies` — that doc also carries the
    // superadmin's private notes and usage figures, and Firestore rules grant
    // access per document, not per field, so a company admin reading their
    // own `companies` doc would see those too.
    match /companyAddons/{companyId} {
      allow read:  if isSuperadmin() || isCompanyAdmin(companyId);
      allow write: if isSuperadmin();
    }

    match /technicians/{uid} {
      // Anyone signed in may also see the roster of *registered technicians*
      // specifically (not other admins' or trainees' docs) — needed to list
      // possible site-assignees, and for a trainee to pick which technician
      // witnessed a logbook entry. `technicianLookup` (below) is already
      // world-readable even pre-login, so this is a narrower exposure than
      // what already exists, not a new one. All of this stays inside one
      // company — a technician never sees another company's roster.
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isSuperadmin()
        || (isAdmin() && myCompanyId() == resource.data.companyId)
        || (resource.data.role == 'technician' && myCompanyId() == resource.data.companyId)
      );
      // Provisioning (and the seat-limit check that guards it) happens only in
      // the `createTechnician` / `createCompany` Cloud Functions via the Admin
      // SDK, which bypasses these rules — so no client may create or delete a
      // technician doc directly. An admin may still edit an existing one
      // (name, phone, canCalibrate, deactivate) within their own company —
      // except flipping active:false back to true, which is the same
      // seat-limit-checked operation as creating a technician and is
      // deliberately routed through the `reactivateTechnician` Cloud Function
      // instead (bypasses this rule via the Admin SDK once the seat check
      // passes), so a company can't reactivate past its plan's seat limit.
      allow create, delete: if false;
      allow update: if (
        isCompanyAdmin(resource.data.companyId)
        && !(resource.data.active == false && request.resource.data.active == true)
      ) || (
        // Self-service last-login stamp, written on sign-in (see
        // onAuthStateChanged in index.html) — the only field a technician
        // may ever write on their own doc.
        isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt'])
      );
    }

    // Each entry also carries a companyId (denormalised at write time) purely
    // so this rule can scope writes to the admin's own company — plain
    // isAdmin() here would let any company's admin repoint or delete any
    // other company's technician-number-to-email mapping.
    match /technicianLookup/{techNumber} {
      // Read stays open pre-login (no auth context yet) to resolve a
      // technician number to an email before signing in. Technician numbers
      // are a single flat, globally-unique namespace shared by every company
      // (the login form has no company selector) — that's an existing
      // constraint, not new here.
      allow read: if true;
      // The `createTechnician` Cloud Function writes new entries via the
      // Admin SDK (bypassing rules) as part of its seat-limit check. An admin
      // may still repoint/remove an entry directly within their own company —
      // e.g. `qualifyTrainee()` renumbers one when a trainee qualifies.
      allow create, update: if isAdmin() && myCompanyId() == request.resource.data.companyId
        && (resource == null || resource.data.companyId == myCompanyId());
      allow delete: if isAdmin() && resource.data.companyId == myCompanyId();
    }

    // SAQCC (Fire) trainee 6-month supervised placement. One doc per trainee,
    // keyed by the trainee's own uid (never an auto-ID) — that keeps "is this
    // my assignment" a free path check and "am I the supervisor" a single
    // resource-data read, with no query needed. Only an admin assigns or
    // reassigns; the trainee and their current supervisor may read it.
    match /traineeAssignments/{traineeId} {
      allow read: if isCompanyAdmin(resource.data.companyId)
        || (isSignedIn() && request.auth.uid == traineeId)
        || (isSignedIn() && resource.data.supervisorId == request.auth.uid);
      allow create: if isCompanyAdmin(request.resource.data.companyId);
      allow update, delete: if isCompanyAdmin(resource.data.companyId);
    }

    // A trainee's daily logbook entry (SAQCC Fire paper form, digitised). The
    // trainee owns and can freely edit their own entry while it's a draft;
    // only the registered technician named as witness may add comments and
    // flip it to "signed" — the SAQCC form is explicit that signing off work
    // you didn't personally witness is fraud, so that transition is
    // restricted to their own uid and to exactly the sign-off fields. Once
    // signed, nobody but an admin may touch it again.
    match /logbookEntries/{id} {
      allow read: if isCompanyAdmin(resource.data.companyId)
        || (isSignedIn() && resource.data.traineeId == request.auth.uid)
        || (isSignedIn() && resource.data.technicianId == request.auth.uid);

      // A trainee's first save (create) and a technician's sign-off both go
      // through the `createLogbookEntry` / `signLogbookEntry` Cloud Functions
      // instead of a direct client write — those two events are the ones the
      // device/IP fraud-tracking fields need to be trustworthy for, which a
      // security rule can't capture (there's no real client IP available to
      // a rule, and the Admin SDK is the only way to stamp one reliably).
      // Both functions also require the actor to have completed their own
      // profile first (see `requireProfileComplete`), a check that likewise
      // has to live server-side.
      allow create: if isCompanyAdmin(request.resource.data.companyId);

      allow update: if isCompanyAdmin(resource.data.companyId)
        || (
          isSignedIn() && resource.data.traineeId == request.auth.uid
          && resource.data.status == 'draft' && request.resource.data.status == 'draft'
          // Re-validated exactly as on create — otherwise a trainee editing
          // their own still-draft entry could repoint traineeId/companyId,
          // or name a witness who isn't actually a same-company technician.
          && request.resource.data.traineeId == resource.data.traineeId
          && request.resource.data.companyId == resource.data.companyId
          && get(/databases/$(database)/documents/technicians/$(request.resource.data.technicianId)).data.role == 'technician'
          && get(/databases/$(database)/documents/technicians/$(request.resource.data.technicianId)).data.companyId == resource.data.companyId
        );

      allow delete: if isCompanyAdmin(resource.data.companyId)
        || (isSignedIn() && resource.data.traineeId == request.auth.uid && resource.data.status == 'draft');
    }

    // Progress against the SAQCC (Fire) "aspects to practice on-the-job"
    // checklist. One doc per trainee, keyed by their uid like the assignment
    // it's read alongside. Assessing competence is the current supervisor's
    // call (or admin's) — unlike a daily logbook entry, this isn't something
    // any witnessing technician should be able to sign off.
    match /traineeCompetencies/{traineeId} {
      allow read: if isCompanyAdmin(resource.data.companyId)
        || (isSignedIn() && request.auth.uid == traineeId)
        || (isSignedIn() && get(/databases/$(database)/documents/traineeAssignments/$(traineeId)).data.supervisorId == request.auth.uid);
      allow write: if isCompanyAdmin(request.resource.data.companyId)
        || (isSignedIn() && get(/databases/$(database)/documents/traineeAssignments/$(traineeId)).data.supervisorId == request.auth.uid);
    }

    match /sites/{siteId} {
      allow read: if isSuperadmin() || isCompanyAdmin(resource.data.companyId)
        || (isSignedIn() && request.auth.uid in resource.data.assignedTo)
        || (isSignedIn() && request.auth.uid in resource.data.assignedCompetentPersons);
      allow create: if isCompanyAdmin(request.resource.data.companyId);
      allow delete: if isCompanyAdmin(resource.data.companyId);
      // Admins may change anything within their own company. An assigned
      // technician may only touch a restricted set of fields (site details +
      // completion markers) — `assignedTo` is deliberately absent here too:
      // only an administrator decides who has access to a site, or a
      // technician could grant an arbitrary account (any uid, any company)
      // access to the site and its equipment by rewriting their own
      // assignment list. `serviceType` and `companyId` are deliberately
      // absent as well: only an administrator sets them, and a site can never
      // change tenant.
      allow update: if isCompanyAdmin(resource.data.companyId)
        || (
          isSignedIn()
          && request.auth.uid in resource.data.assignedTo
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name','address','notes','email','contactPerson','contactPhone','category','completed','completedAt','lastCompletedDate','lastCompletedBy'])
        );
    }

    // Company letterhead / registration details used on generated certificates.
    // One doc per tenant, keyed by companyId (not the literal "company").
    match /settings/{companyId} {
      allow read: if isSignedIn() && myCompanyId() == companyId;
      allow write: if isCompanyAdmin(companyId);
    }

    // Audit tab (Company Documents / Employees / Vehicles / Workshops /
    // Calibration) — the servicing business's own compliance evidence for a
    // SAQCC/SABS audit, as opposed to the client-facing site registers and
    // certificates. Gated behind the `audit` company add-on (hasAuditAddon,
    // above) — a superadmin grants it per company in admin.html; off by
    // default for every company. Otherwise plain company-admin pattern:
    // create checks the incoming companyId, everything else checks the
    // stored one. A `list` query on any of these must filter
    // `where('companyId','==', <own>)` for the read rule to be provable.
    // Employee compliance data (SAQCC/medical expiry, ID copies) lives on the
    // existing `technicians` doc, written by the admin through the update
    // rule above — no separate collection.
    match /branches/{id} {
      allow read:   if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
      allow create: if isCompanyAdmin(request.resource.data.companyId) && hasAuditAddon(request.resource.data.companyId);
      allow update: if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
      allow delete: if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
    }
    match /vehicles/{id} {
      allow read:   if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
      allow create: if isCompanyAdmin(request.resource.data.companyId) && hasAuditAddon(request.resource.data.companyId);
      allow update: if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
      allow delete: if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
    }
    match /companyDocuments/{id} {
      allow read:   if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
      allow create: if isCompanyAdmin(request.resource.data.companyId) && hasAuditAddon(request.resource.data.companyId);
      allow update: if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
      allow delete: if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
    }
    // Annual external calibration of the workshop's reference instruments by a
    // SANAS-accredited body — one record + certificate upload per instrument.
    // Distinct from `calibrations` (below), which is the *weekly verification*
    // log. Admin-managed only, and gated behind the same Audit add-on; the
    // certificate files live under company-files/{companyId}/calibration/ in
    // Storage.
    match /calibrationCertificates/{id} {
      allow read:   if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
      allow create: if isCompanyAdmin(request.resource.data.companyId) && hasAuditAddon(request.resource.data.companyId);
      allow update: if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
      allow delete: if isCompanyAdmin(resource.data.companyId) && hasAuditAddon(resource.data.companyId);
    }

    // Weekly verification log (SANS 1475 Annex A) — production-control equipment
    // checked against reference instruments at least weekly. Collection name is
    // `calibrations` for historical reasons; the app now calls this "Weekly
    // verification" (the real calibration register is `calibrationCertificates`
    // above). Entries are added by an admin or by a technician the admin has
    // granted the `canCalibrate` permission; only an admin may change or remove one.
    match /calibrations/{id} {
      allow read:   if isSuperadmin() || isCompanyAdmin(resource.data.companyId) || (isSignedIn() && myCompanyId() == resource.data.companyId);
      allow create: if isCompanyAdmin(request.resource.data.companyId)
        || (canCalibrate() && myCompanyId() == request.resource.data.companyId);
      allow update, delete: if isCompanyAdmin(resource.data.companyId);
    }

    // Monthly responsible-person inspection log (SANS 10105-1). One record per
    // site per month. Read access is restricted to whichever Competent
    // Person(s) are assigned to the site — not a maintenance technician's
    // assignedTo list, which is a deliberately separate access boundary.
    // Writing goes through the `saveMonthlyCheck` Cloud Function instead of a
    // direct client write, for the same reason logbook create/sign do: a
    // real server-observed IP alongside the device id, and the profile-
    // completion gate has to be enforced server-side. Admin may still write
    // directly (e.g. filling one in themselves) and may delete.
    match /monthlyChecks/{id} {
      allow read:           if isCompanyAdmin(resource.data.companyId) || (isSignedIn() && isAssignedAsCompetentPerson(resource.data.siteId));
      allow create, update: if isCompanyAdmin(request.resource.data.companyId);
      allow delete:         if isCompanyAdmin(resource.data.companyId);
    }

    // Immutable service-history / audit trail. One snapshot is appended whenever
    // an equipment record's compliance fields change. Write-once: no one may
    // edit or delete an entry (corrections are made by adding a new one).
    // Purging genuinely bad data is a Firebase Console operation.
    match /serviceEvents/{id} {
      allow read:           if isSuperadmin() || isCompanyAdmin(resource.data.companyId) || (isSignedIn() && isAssignedToSite(resource.data.siteId));
      allow create:         if isCompanyAdmin(request.resource.data.companyId) || (isSignedIn() && isAssignedToSite(request.resource.data.siteId));
      allow update, delete: if false;
    }

    // Audit log of register / certificate emails sent from a site. Written only
    // by the `emailSiteDocuments` Cloud Function via the Admin SDK (which
    // bypasses these rules); no client may write. Admins read it in the app.
    match /emailLog/{id} {
      allow read:  if isSuperadmin() || isCompanyAdmin(resource.data.companyId);
      allow write: if false;
    }

    // An "equipment" doc is the physical asset (type, serial, location) plus a
    // denormalised snapshot of its most recent inspection for list rendering.
    match /equipment/{eqId} {
      // A Competent Person may only ever read equipment (they need to know
      // what's on site to build the monthly checklist) — never create,
      // update or delete it. That asymmetry is the actual "completely
      // separate from maintenance" boundary for this collection.
      allow read:   if isSuperadmin() || isCompanyAdmin(resource.data.companyId) || (isSignedIn() && isAssignedToSite(resource.data.siteId)) || (isSignedIn() && isAssignedAsCompetentPerson(resource.data.siteId));
      allow create: if isCompanyAdmin(request.resource.data.companyId) || (isSignedIn() && isAssignedToSite(request.resource.data.siteId));
      allow update: if isCompanyAdmin(resource.data.companyId) || (isSignedIn() && isAssignedToSite(resource.data.siteId));
      allow delete: if isCompanyAdmin(resource.data.companyId);

      // Each inspection is an immutable-by-technicians history entry. It carries
      // its own siteId and companyId (copied from the parent) so this rule
      // needs no nested lookup of the equipment doc. Technicians assigned to
      // the site can log new inspections; only an admin may edit or delete a
      // saved one.
      match /inspections/{inspId} {
        allow read:   if isCompanyAdmin(resource.data.companyId) || (isSignedIn() && isAssignedToSite(resource.data.siteId));
        allow create: if isCompanyAdmin(request.resource.data.companyId) || (isSignedIn() && isAssignedToSite(request.resource.data.siteId));
        allow update, delete: if isCompanyAdmin(resource.data.companyId);
      }
    }
  }
}
