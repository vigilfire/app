# Copy this file to functions/.env and edit as needed, then redeploy the functions.
# (functions/.env is git-ignored — the RESEND_API_KEY is a secret, not stored here.)

# Sender shown on the email. Until a domain is verified in Resend, leave this as
# the onboarding sender below — Resend then only delivers to the address that
# owns the Resend account. After verifying a domain (e.g. vigilfire.co.za),
# change this to an address at that domain:
#   EMAIL_FROM="Vigil Fire <certificates@vigilfire.co.za>"
EMAIL_FROM="Vigil Fire <onboarding@resend.dev>"

# Optional. Leave blank to use the company email from settings/company as the
# reply-to (recommended — replies then reach the servicing company's inbox).
EMAIL_REPLY_TO=""
