rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Path is equipment-photos/{companyId}/{fileName} — the companyId segment
    // lets this rule check tenant isolation directly from the path, with no
    // need to look up the equipment doc itself (which doesn't exist yet at
    // upload time for a brand-new item, so there'd be nothing to check
    // against). Mirrors the isCompanyAdmin()/myCompanyId() pattern in
    // firestore.rules — a signed-in user may only reach their own company's
    // photos, and the internal /admin superadmin claim reaches all of them.
    match /equipment-photos/{companyId}/{fileName} {
      allow read, write: if request.auth != null && (
        request.auth.token.role == 'superadmin' ||
        firestore.get(/databases/(default)/documents/technicians/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // Self-service profile photo + SAQCC card photo (fraud-tracking profile
    // completion — see firestore.rules technicians.completeMyProfile). Only
    // the technician/trainee themselves may write their own two files; the
    // rest of their own company (and the superadmin) may read them, since an
    // admin needs to be able to check the SAQCC card photo.
    match /technician-photos/{companyId}/{uid}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'superadmin' ||
        firestore.get(/databases/(default)/documents/technicians/$(request.auth.uid)).data.companyId == companyId
      );
      allow write: if request.auth != null && request.auth.uid == uid &&
        firestore.get(/databases/(default)/documents/technicians/$(request.auth.uid)).data.companyId == companyId;
    }

    // Workshop / auditor file: company statutory documents, service-vehicle
    // papers, and employee compliance documents (ID copies, medical
    // certificates, employment contracts). Unlike technician-photos/ — which
    // is self-service, writable only by its owning uid — these are uploaded by
    // a company admin on behalf of the business, so write is gated on the
    // caller being an admin of the matching company. Accepts PDF as well as
    // images (statutory documents are usually PDFs), capped at 15 MB. One
    // {path=**} block covers documents/, vehicles/<id>/, employees/<uid>/ and
    // branches/<id>/ under the company folder.
    match /company-files/{companyId}/{path=**} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'superadmin' ||
        firestore.get(/databases/(default)/documents/technicians/$(request.auth.uid)).data.companyId == companyId
      );
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/technicians/$(request.auth.uid)).data.role == 'admin' &&
        firestore.get(/databases/(default)/documents/technicians/$(request.auth.uid)).data.companyId == companyId &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/.*');
    }

    // Legacy path from before multi-tenancy (equipment-photos/{fileName}.jpg,
    // no companyId segment) — kept readable/writable by any signed-in user,
    // same exposure as before this change, purely so photos uploaded before
    // this rule shipped don't go dark. Every new upload uses the company-
    // scoped path above. Safe to delete this block once old files have been
    // migrated or are no longer needed.
    match /equipment-photos/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
